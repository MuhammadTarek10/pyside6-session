<!DOCTYPE RCC>
<RCC version="1.0">
  <qresource prefix="/icons">
    <file alias="open.svg">icons/open.svg</file>
    <file alias="zoom-in.svg">icons/zoom-in.svg</file>
    <file alias="zoom-out.svg">icons/zoom-out.svg</file>
    <file alias="fit.svg">icons/fit.svg</file>
    <file alias="about.svg">icons/about.svg</file>
    <file alias="quit.svg">icons/quit.svg</file>
    <file alias="rotate.svg">icons/rotate.svg</file>
    <file alias="dark.svg">icons/dark.svg</file>
  </qresource>
  <qresource prefix="/images">
    <file alias="logo.svg">images/logo.svg</file>
  </qresource>
  <qresource prefix="/styles">
    <file alias="style.qss">styles/style.qss</file>
    <file alias="dark.qss">styles/dark.qss</file>
  </qresource>
</RCC>
